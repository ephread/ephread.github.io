---
import { createHash } from "node:crypto";
import { ClientRouter } from "astro:transitions";
import { availability, intro, social as defaultSocial } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  /** Title and description shown when the page is shared. */
  social?: {
    title: string;
    description: string;
  };
}

const {
  title,
  description = "Hey, I'm Fred, this is my personal website.",
  lang = "en",
  bodyClass,
  social = defaultSocial,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The version changes with the image's content, so social networks fetch it again.
const socialImageVersion = createHash("sha256").update(`${availability}\n${intro}`).digest("hex").slice(0, 8);
const socialImage = new URL(`/social.png?v=${socialImageVersion}`, Astro.site);
---

<!doctype html>
<!-- Pages swap instantly: the router's default cross-fade is turned off. -->
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={social.title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:description" content={social.description} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#009a9c" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />

    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
