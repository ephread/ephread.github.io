---
import { ClientRouter } from "astro:transitions";
import {
  availability,
  availabilityLabels,
  avatar,
  headline,
  intro,
  social as defaultSocial,
  socialImageSize,
} from "../data/site";
import { version } from "../social/render";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  /** Title and description shown when the page is shared. */
  social?: {
    title: string;
    description: string;
  };
  /** The page's preview image (see src/social/); defaults to the home page's. */
  socialImage?: {
    path: string;
    /** Changes with the image's content (see version() in src/social/render.ts). */
    version: string;
    alt: string;
  };
}

const {
  title,
  description = intro,
  lang = "en",
  bodyClass,
  social = defaultSocial,
  socialImage: image = {
    path: "/social.png",
    version: version(availability, headline, avatar.src),
    alt: `Frédéric Maquin's photo, status: ${availabilityLabels[availability]}. ${headline}`,
  },
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The version is in the URL so social networks fetch the image again when it changes.
const socialImage = new URL(`${image.path}?v=${image.version}`, Astro.site);
const socialImageAlt = image.alt;
---

<!doctype html>
<!-- Pages swap instantly: the router's default cross-fade is turned off. -->
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={social.title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:description" content={social.description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(socialImageSize.width)} />
    <meta property="og:image:height" content={String(socialImageSize.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- The phone browser's toolbar, matching the page background in each mode. -->
    <meta name="theme-color" content="#f9f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181715" media="(prefers-color-scheme: dark)" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#006869" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />

    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
