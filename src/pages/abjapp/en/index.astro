---
import AppLayout from "../../../layouts/AppLayout.astro";
import ContactForm from "../../../components/app/ContactForm.astro";
import icon from "../../../assets/images/abjapp-icon.svg";
---

<AppLayout app="abjapp" title="Abjapp | Contact" lang="en">
  <ContactForm
    icon={icon}
    iconAlt="Abjapp"
    action="https://formspree.io/f/mrgjovqz"
    subject="Abjapp: Feedback"
    lang="en"
  >
    Do you have questions, suggestions or some feedback for Abjapp? Just fill the form below and we'll email you back as soon as possible!
  </ContactForm>
</AppLayout>
