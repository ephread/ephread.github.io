---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CloseButton from "../../components/showcase/CloseButton.astro";
import ShowcaseIllustration from "../../components/showcase/ShowcaseIllustration.astro";
import ProjectTitle from "../../components/showcase/ProjectTitle.astro";
import ProjectInformation from "../../components/showcase/ProjectInformation.astro";
import ProjectContent from "../../components/showcase/ProjectContent.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (project) => project.data.tile !== undefined);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, tagline, color, accent = color, linksUseAccent } = project.data;

const { Content } = await render(project);

// Sub-projects (ink's) are shown one after the other below the introduction.
const subprojects = (await getCollection("projects", (entry) => entry.data.parent?.id === project.id)).sort(
  (a, b) => a.data.order - b.data.order,
);

const style = [
  `--accent: var(--color-${accent})`,
  `--accent-dark: var(--color-${accent}-dark)`,
  linksUseAccent && "--link-color: var(--accent); --link-color-hover: var(--accent-dark)",
]
  .filter(Boolean)
  .join("; ");
---

<BaseLayout title={`${name} | Frédéric Maquin`} description={tagline} bodyClass="bg-white">
  <main style={style}>
    <CloseButton />
    <ShowcaseIllustration project={project} />

    {subprojects.length > 0 ? (
      <>
        <h1 class="sr-only">{name}</h1>
        <section class="text-area *:mt-[2.5em]">
          <Content />
        </section>
        {subprojects.map((subproject) => (
          <section class="mt-[4em] before:mb-[4em] before:block before:h-[.2em] before:w-full before:bg-(--accent) before:opacity-6 before:content-['']">
            <ProjectTitle name={subproject.data.name} tagline={subproject.data.tagline} level={2} />
            <ProjectInformation project={subproject} />
            <ProjectContent project={subproject} />
          </section>
        ))}
      </>
    ) : (
      <>
        <ProjectTitle name={name} tagline={tagline} />
        <ProjectInformation project={project} />
        <ProjectContent project={project} />
      </>
    )}
  </main>
</BaseLayout>
