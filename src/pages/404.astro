---
import SiteLayout from "../layouts/SiteLayout.astro";
import Footer from "../components/Footer.astro";
---

<SiteLayout title="Page not found | Frédéric Maquin" description="This page doesn't exist.">
  <section class="wrap flex min-h-[60svh] flex-col items-start justify-center gap-5 py-16">
    <p class="eyebrow">Error 404</p>
    <h1 class="font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-none font-bold tracking-[-0.02em]">
      This page fell off the tree.
    </h1>
    <p class="max-w-[32em] text-xl/normal text-fg-muted">
      It may have moved, or never existed. The rest of the harvest is still here.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a href="/" class="pill bg-teal text-on-teal hover:bg-teal-dark">
        Go to the home page
      </a>
      <a href="/#work" class="pill border border-line bg-surface text-fg hover:border-fg-subtle">
        See my work
      </a>
    </div>
  </section>
  <Footer slot="footer" />
</SiteLayout>
