---
import SiteLayout from "../layouts/SiteLayout.astro";
import Footer from "../components/Footer.astro";

// Temporary sections so the navigation can be tested; replaced in Phase 3.
const sections = ["landing", "about", "work", "get-in-touch"];
---

<SiteLayout title="Frédéric Maquin | Independent iOS developer">
  {
    sections.map((id, index) => (
      <section id={id} class:list={["grid min-h-dvh place-items-center", index % 2 ? "bg-white" : "bg-beige"]}>
        <h3 class="text-[2.5em] text-green uppercase">{id}</h3>
      </section>
    ))
  }
  <a href="/thanks/" class="text-link">Thanks page</a>
  <Footer slot="footer" />
</SiteLayout>
