---
import SiteLayout from "../layouts/SiteLayout.astro";
import Footer from "../components/Footer.astro";
import Landing from "../components/home/Landing.astro";
import About from "../components/home/About.astro";
import Work from "../components/home/Work.astro";
import GetInTouch from "../components/home/GetInTouch.astro";
---

<SiteLayout title="Frédéric Maquin | Independent iOS developer">
  <script is:inline slot="head">
    // Showcases used to be in-page overlays (/#abjapp-showcase); they now have their own pages.
    (function () {
      var match = location.hash.match(/^#([a-z-]+)-showcase$/);
      if (match) location.replace("/work/" + match[1] + "/");
    })();
  </script>
  <Landing />
  <About />
  <Work />
  <GetInTouch />
  <Footer slot="footer" />
</SiteLayout>
