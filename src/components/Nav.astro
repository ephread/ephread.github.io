---
import { Image } from "astro:assets";
import apple from "../assets/images/apple.svg";

// On the home page, links point at in-page anchors; elsewhere they go back home.
const base = Astro.url.pathname === "/" ? "" : "/";

const links = [
  { section: "about", label: "About" },
  { section: "work", label: "Work" },
];
---

<nav
  id="navigation"
  class="sticky top-0 z-1000 border-b border-transparent bg-beige/95 backdrop-blur transition-colors data-scrolled:border-line"
>
  <div class="wrap flex flex-wrap items-center justify-between gap-4 py-4 sm:py-5">
    <a
      href={`${base}#top`}
      class="flex items-center gap-2.5 rounded-md font-display text-xl font-bold text-fg no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal"
    >
      <Image src={apple} alt="" class="size-6.5" />
      Fred Maquin
    </a>
    <ul class="flex items-center gap-5 text-[.9375rem] font-medium sm:gap-7">
      {links.map(({ section, label }) => (
        <li class="max-sm:hidden">
          <a
            href={`${base}#${section}`}
            data-section={section}
            class="relative rounded-sm py-1 text-fg after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:translate-y-1.5 after:rounded-full after:bg-teal after:opacity-0 after:transition-all after:duration-300 after:ease-in-out hover:after:translate-y-0 hover:after:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal aria-[current=location]:after:translate-y-0 aria-[current=location]:after:opacity-100 motion-reduce:after:transition-none"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href={`${base}#get-in-touch`} class="pill bg-teal px-4.5 py-3 text-on-teal hover:bg-teal-dark">
          Get in touch
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  let cleanUp: (() => void) | undefined;

  function setUpNavigation() {
    cleanUp?.();

    const nav = document.getElementById("navigation");
    if (!nav) return;

    const links = new Map<string, HTMLAnchorElement>();
    for (const link of nav.querySelectorAll<HTMLAnchorElement>("a[data-section]")) {
      if (link.dataset.section) links.set(link.dataset.section, link);
    }

    const sections = [...document.querySelectorAll<HTMLElement>("main section[id]")];

    const setActive = (id: string | undefined) => {
      for (const [section, link] of links) {
        if (section === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    // The current section is the last one whose top has passed a line just below
    // where anchor links land it (its scroll-margin-top, which clears the nav bar).
    // Above the first section, in the hero, there's none.
    const onScroll = () => {
      nav.toggleAttribute("data-scrolled", window.scrollY > 1);
      if (sections.length === 0) return;

      const line = Math.ceil(parseFloat(getComputedStyle(sections[0]).scrollMarginTop)) + 1;
      setActive(sections.findLast((section) => section.getBoundingClientRect().top <= line)?.id);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    onScroll();

    cleanUp = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      cleanUp = undefined;
    };
  }

  document.addEventListener("astro:page-load", setUpNavigation);
  document.addEventListener("astro:before-swap", () => cleanUp?.());
</script>
