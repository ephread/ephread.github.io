---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/#work"
  data-close-showcase
  class:list={[
    "inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-[.9375rem] font-semibold no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current",
    className,
  ]}
>
  <span aria-hidden="true">←</span> All work
</a>

<script>
  import { previousPathname } from "../../scripts/navigation";

  // When the case study was opened from the home page, going back to it goes back in
  // history so the home page comes back scrolled to the card that was clicked.
  function close(event: Event) {
    if (previousPathname() !== "/") return; // Follow the link to /#work.
    event.preventDefault();
    history.back();
  }

  function onKeyDown(event: KeyboardEvent) {
    if (event.key === "Escape") document.querySelector<HTMLAnchorElement>("[data-close-showcase]")?.click();
  }

  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector("[data-close-showcase]");
    document.removeEventListener("keydown", onKeyDown);
    if (!button) return;

    button.addEventListener("click", close);
    document.addEventListener("keydown", onKeyDown);
  });
</script>
