---
import { Image } from "astro:assets";
import brush from "../../assets/images/brush-icon.svg";
import hammer from "../../assets/images/hammer-icon.svg";
import rocket from "../../assets/images/rocket-icon.svg";

const skills = [
  { label: "UI Design", icon: brush },
  { label: "Development", icon: hammer },
  { label: "Deployment", icon: rocket },
];
---

<div class="my-[1.5em] flex w-full flex-col items-center justify-center bg-[#fcfaf8] p-[1.5em] md:p-[3em]">
  <!-- The rail is the line joining the icons on wider screens. -->
  <div class="relative w-full max-w-[1280px] md:before:absolute md:before:top-[calc(3em-1.5px)] md:before:left-[2em] md:before:z-500 md:before:h-[3px] md:before:w-[calc(100%-1px-4em)] md:before:bg-beige-dark md:before:content-['']">
    <ul class="relative flex flex-wrap items-center justify-center md:justify-between">
      {skills.map(({ label, icon }) => (
        <li class="mx-[2em] my-[1em] flex flex-[0_0_5em] flex-col items-center justify-center md:my-0">
          <Image
            src={icon}
            alt=""
            class="z-600 size-[6em] max-w-none rounded-full border-2 border-beige-dark md:border-3"
          />
          <span class="mt-[1em] text-center font-headline text-[1.2em] text-green uppercase">{label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
