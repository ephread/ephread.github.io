---
import { availability, availabilityLabels } from "../../data/site";

const dotColors = {
  available: "bg-status-available",
  limited: "bg-status-limited",
  unavailable: "bg-status-unavailable",
};
---

<p class="inline-flex items-center gap-2 self-start rounded-full border border-line bg-surface py-1.5 pr-3.5 pl-2.5 text-sm font-medium">
  <span class:list={["size-2 rounded-full", dotColors[availability]]} aria-hidden="true"></span>
  {availabilityLabels[availability]}
</p>
