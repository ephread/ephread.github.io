---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { tile, color } = project.data;
if (!tile) throw new Error(`Project "${project.id}" has no tile.`);

const large = tile.size === "large";
const background = tile.background
  ? `background-image: url(${tile.background.src}); background-size: cover; background-position: center`
  : `background-color: var(--color-${color})`;
---

<div class:list={["flex-[0_0_100%] p-[1em] lg:p-[2em]", large ? "md:flex-[0_0_50%]" : "md:flex-[0_0_33.33%]"]}>
  <a
    href={`/work/${project.id}/`}
    class="group block rounded-[.5em] text-black no-underline transition-all duration-300 ease-in-out hover:scale-105 hover:shadow-[0_0_.6em_--alpha(var(--color-black)/10%)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green"
    style={background}
  >
    <!--
      The image fills the width and stays centered, like the old background-size: 100%.
      This colored block morphs into the showcase's header when the tile is opened.
    -->
    <div
      class="relative aspect-[100/55] overflow-hidden rounded-t-[.5em]"
      style={background}
      transition:name={`project-${project.id}`}
    >
      <Image
        src={tile.image}
        alt={tile.imageAlt}
        {...tile.image.format !== "svg" && {
          widths: [400, 800, 1200],
          sizes: large ? "(width >= 45.0625em) 50vw, 100vw" : "(width >= 45.0625em) 33vw, 100vw",
        }}
        class="absolute inset-x-0 top-1/2 w-full -translate-y-1/2 transition-transform duration-300 ease-in-out group-hover:scale-120"
      />
    </div>
    <div class="flex w-full rounded-b-[.3em] bg-white p-[1em] text-[1.2em]">
      <p class:list={["w-full text-center font-bold", !large && "text-[.9em]"]}>{tile.platforms}</p>
    </div>
  </a>
</div>
