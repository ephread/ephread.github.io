---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectTile from "./ProjectTile.astro";

/** A project shown in the work list, i.e. one with a tile. */
type Project = CollectionEntry<"projects"> & {
  data: { tile: NonNullable<CollectionEntry<"projects">["data"]["tile"]> };
};

const projects = (
  await getCollection(
    "projects",
    (project): project is Project => project.data.tile !== undefined && !project.data.hidden,
  )
).sort((a, b) => a.data.order - b.data.order);

const inGroup = (group: Project["data"]["tile"]["group"]) =>
  projects.filter((project) => project.data.tile.group === group);

// Large cards fill half the column from md up, small ones a third from lg up.
const halfSizes = "(width >= 48rem) 576px, 100vw";
const thirdSizes = "(width >= 64rem) 384px, (width >= 48rem) 50vw, 100vw";

const groups = [
  { title: "Indie", projects: inGroup("indie"), grid: "md:grid-cols-2", sizes: halfSizes },
  {
    title: "Selected contracts",
    projects: inGroup("contracts"),
    grid: "md:grid-cols-2 lg:grid-cols-3",
    sizes: thirdSizes,
  },
];

const featured = inGroup("featured");
const archive = inGroup("open-source");
---

<section id="work" class="wrap pt-10 pb-12 sm:pt-12">
  <h2 class="font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-tight font-bold tracking-[-0.02em]">
    Selected work
  </h2>

  <div class="mt-12 sm:mt-14">
    <h3 class="eyebrow mb-5">Featured</h3>
    <div class:list={["grid gap-6", featured.length > 1 && "md:grid-cols-2"]}>
      {featured.map((project) => (
        <ProjectTile project={project} featured wide={featured.length === 1} sizes={halfSizes} />
      ))}
    </div>
  </div>

  {groups.map(({ title, projects, grid, sizes }) => (
    <div class="mt-14">
      <h3 class="eyebrow mb-5">{title}</h3>
      <div class:list={["grid gap-6", grid]}>
        {projects.map((project) => (
          <ProjectTile project={project} sizes={sizes} />
        ))}
      </div>
    </div>
  ))}

  <div class="mt-18">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h3 class="eyebrow">Open source archive</h3>
      <p class="text-[.9375rem] text-fg-muted">Past projects, no longer maintained.</p>
    </div>
    <ul class="card p-2">
      {archive.map(({ id, data: { name, tagline, color, tile } }) => (
        <li>
          <a
            href={`/work/${id}/`}
            class="group flex items-center gap-4 rounded-[.875rem] p-3 sm:gap-5 text-fg no-underline transition-colors hover:bg-beige focus-visible:outline-2 focus-visible:outline-teal"
          >
            <span
              class="relative h-12 w-22 flex-none self-start sm:self-center overflow-hidden rounded-[.625rem]"
              style={tile.background ? `background-image: url(${tile.background.src})` : `background-color: ${color}`}
            >
              <Image src={tile.image} alt="" class="absolute inset-x-0 top-1/2 w-full -translate-y-1/2" />
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span class="font-display text-lg font-bold">{name}</span>
              <span class="text-[.9375rem] text-fg-muted">{tagline}</span>
              <span class="mt-1 text-[.8125rem] font-medium text-fg-subtle sm:hidden">{tile.platforms}</span>
            </span>
            <span class="text-right text-[.8125rem] font-medium text-fg-subtle max-sm:hidden">{tile.platforms}</span>
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="flex-none text-fg-subtle transition-transform group-hover:translate-x-0.5 max-sm:hidden motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
