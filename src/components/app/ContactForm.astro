---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  icon: ImageMetadata;
  iconAlt: string;
  /** Formspree endpoint. */
  action: string;
  subject: string;
  /** Page Formspree redirects to after sending; Formspree's own page otherwise. */
  next?: string;
  lang?: "en" | "fr";
}

const { icon, iconAlt, action, subject, next, lang = "en" } = Astro.props;

const labels = {
  en: { email: "Your email address", message: "Your message" },
  fr: { email: "Votre adresse e-mail", message: "Votre message" },
}[lang];

// Shared by the text fields and the submit button. Padding and line height are
// set per element: conflicting utilities on one element don't override in class order.
const control =
  "my-[.5em] w-full rounded-[12px] border-0 text-[1.2em] outline-none";
const field = `${control} bg-app-field text-app-fg focus:shadow-[0_0_0_2px_var(--color-app-accent)]`;
const singleLine = "px-[1em] leading-[3em]";
---

<div class="mx-auto my-[3em] w-[90%] text-[.8em] lg:w-[50em] lg:text-[1em]">
  <div>
    <Image src={icon} alt={iconAlt} class="mx-auto mb-[2em] block size-[8em]" />
    <p class="my-[1em] text-[1.5em] leading-[1.5em]">
      <slot />
    </p>
  </div>

  <div>
    <form action={action} method="POST">
      <input
        type="email"
        name="_replyto"
        placeholder="email@example.com"
        aria-label={labels.email}
        required
        class={`${field} ${singleLine}`}
      />
      <textarea
        name="message"
        placeholder="Message"
        aria-label={labels.message}
        required
        class:list={[
          field,
          "min-h-[15em] resize-none p-[1em] align-middle leading-[1.2em]",
        ]}
      ></textarea>
      {next && <input type="hidden" name="_next" value={next} />}
      <input type="hidden" name="_subject" value={subject} />
      <!-- Honeypot: bots fill it in, people never see it. -->
      <input
        type="text"
        name="_gotcha"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
      />

      <input
        type="submit"
        value="Send"
        class:list={[
          control,
          singleLine,
          "inline-block cursor-pointer rounded-[.75em] bg-app-accent font-bold text-app-on-accent shadow-[0_3px_5px_2px_rgb(0_0_0/0.05)] transition-all duration-500 ease-in-out hover:scale-95 focus-visible:shadow-[0_0_0_2px_var(--color-app-bg),0_0_0_4px_var(--color-app-fg)] active:scale-95",
        ]}
      />
    </form>
  </div>
</div>
