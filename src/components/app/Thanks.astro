---
interface Props {
  title: string;
  message: string;
}

const { title, message } = Astro.props;
---

<section class="flex size-full flex-col items-center justify-center">
  <header class="mx-auto my-[3rem] block w-[90%] max-w-[45rem]">
    <h1 class="mb-[.25em] text-center text-[2.5rem] leading-tight font-bold text-app-heading uppercase">{title}</h1>
    <h2 class="text-center text-[1.5rem] font-normal text-app-text">{message}</h2>
  </header>
</section>
