---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import arrow from "../../assets/images/arrow-icon.svg";
import { technologies as allTechnologies, type Technology } from "../../data/technologies";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { dates, client, technologies, technologiesLabel, illustration } = project.data;

// Flatten grouped technologies into one list of headings and items.
const entries: ({ heading: string } | { technology: Technology })[] = technologies.flatMap((entry) =>
  typeof entry === "string"
    ? [{ technology: entry }]
    : [{ heading: entry.heading }, ...entry.items.map((technology) => ({ technology }))],
);

// Projects with a tinted header use a lighter wash here so the two stay distinct.
const tint = illustration?.background === "tint" ? "bg-(--accent)/3" : "bg-(--accent)/6";

const dt =
  "mb-[.5em] w-[6em] text-left font-headline font-normal text-(--accent) uppercase not-first:mt-[2em] md:float-left md:clear-left md:text-right md:not-first:mt-0";
// The clearfix (rather than flow-root) makes each dd extend past its floated dt's margin, like before.
const dd =
  "relative -top-[.1em] ml-0 not-last:mb-[1em] after:table after:clear-both after:content-[''] md:ml-[8em]";
---

{
  (dates || client || entries.length > 0) && (
    <section class:list={["flex items-center justify-center p-[2em] pb-[1em] text-[1.3em] leading-[1.3em]", tint]}>
      <dl>
        {dates && (
          <>
            <dt class={dt}>Date</dt>
            <dd class={dd}>
              {dates.from}{" "}
              <Image src={arrow} alt="to" class="relative top-[.1em] inline-block size-[1em] scale-80 align-baseline" />{" "}
              {dates.to}
            </dd>
          </>
        )}
        {client && (
          <>
            <dt class={dt}>Client</dt>
            <dd class={dd}>{client}</dd>
          </>
        )}
        {entries.length > 0 && (
          <>
            <dt class={dt}>{technologiesLabel}</dt>
            <dd class={dd}>
              {entries.map((entry) =>
                "heading" in entry ? (
                  <span class="mb-[.5em] block font-bold not-first:mt-[1.5em] last:mb-0">{entry.heading}</span>
                ) : (
                  <span class="mb-[.5em] block last:mb-0">
                    <Image
                      src={allTechnologies[entry.technology].icon}
                      alt=""
                      class="relative -top-[.1em] mr-[.5em] inline-block size-[1em] align-bottom"
                    />
                    {allTechnologies[entry.technology].label}
                  </span>
                ),
              )}
            </dd>
          </>
        )}
      </dl>
    </section>
  )
}
