---
import github from "../assets/images/github-icon.svg";
import keyoxide from "../assets/images/keyoxide-icon.svg";
import linkedin from "../assets/images/linkedin-icon.svg";

// The icons are inlined as components so they take the link's color (currentColor).
const profiles = [
  { name: "GitHub", href: "https://github.com/ephread", Icon: github },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/ephread/", Icon: linkedin },
  { name: "Keyoxide", href: "https://keyoxide.org/fred%40ephread.com", Icon: keyoxide },
];
---

<footer class="wrap">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8 pb-12 text-sm text-fg-subtle max-sm:justify-center">
    <p>Built between two harvests.</p>
    <ul class="flex gap-6">
      {profiles.map(({ name, href, Icon }) => (
        <li>
          <a href={href} class="flex items-center gap-2 text-teal hover:text-teal-dark hover:underline">
            <Icon aria-hidden="true" width="20" height="20" class="flex-none" />
            {name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
